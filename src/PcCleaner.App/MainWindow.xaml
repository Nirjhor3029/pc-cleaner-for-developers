<Window x:Class="PcCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PC Cleaner" Width="560" Height="820" MinWidth="500" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: name on the left, the two other tools as quiet buttons on the right -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PC Cleaner" Style="{StaticResource Text.Title}"/>
                    <Border x:Name="AdminBadge" Style="{StaticResource Pill}" Margin="10,2,0,0" Visibility="Collapsed"
                            ToolTip="Running as administrator - system categories can be scanned and cleaned">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0"/>
                            <TextBlock Text="Admin" Style="{StaticResource Text.Caption}" Foreground="{StaticResource FgBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Measure first, then choose what goes." Style="{StaticResource Text.Caption}"
                           Margin="0,3,12,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="DiskButton" Content="Disk analyzer" Tag="&#xEDA2;" Style="{StaticResource Btn.Small}"
                        Click="DiskButton_Click" ToolTip="Find the largest folders on any drive"/>
                <Button x:Name="SystemToolsButton" Content="System tools" Tag="&#xE713;" Style="{StaticResource Btn.Small}"
                        Margin="8,0,0,0" Click="SystemToolsButton_Click" ToolTip="Hibernation, startup apps and other Windows settings"/>
            </StackPanel>
        </Grid>

        <!-- The capacity gauge: the one bold element -->
        <StackPanel Grid.Row="1" Margin="0,30,0,0">
            <Grid>
                <TextBlock x:Name="DriveTitle" Text="C: drive" Style="{StaticResource Text.Section}"/>
                <TextBlock x:Name="DriveFreeText" Text="" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            </Grid>
            <Border Height="16" CornerRadius="8" Background="{StaticResource MutedBrush}" Margin="0,10,0,0">
                <Grid x:Name="GaugeGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="GaugeUsedCol" Width="0*"/>
                        <ColumnDefinition x:Name="GaugeCleanCol" Width="0*"/>
                        <ColumnDefinition x:Name="GaugeFreeCol" Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="8,0,0,8" Background="{StaticResource GaugeUsedBrush}"/>
                    <Border x:Name="GaugeClean" Grid.Column="1" Background="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="GaugeCleanScale" ScaleX="1"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Ellipse Width="8" Height="8" Fill="{StaticResource GaugeUsedBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="LegendUsed" Text="Used" Style="{StaticResource Text.Caption}" Margin="6,0,18,0"/>
                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="LegendClean" Text="Selected to clean" Style="{StaticResource Text.Caption}" Margin="6,0,18,0"/>
                <Ellipse Width="8" Height="8" Stroke="{StaticResource FgSubtleBrush}" StrokeThickness="1" VerticalAlignment="Center"/>
                <TextBlock x:Name="LegendFree" Text="Free" Style="{StaticResource Text.Caption}" Margin="6,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Amount + actions -->
        <Grid Grid.Row="2" Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TotalSizeText" Text="0 B" Style="{StaticResource Text.Display}" FontSize="36"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="selected to clean" Style="{StaticResource Text.Caption}" Margin="1,-2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ScanButton" Content="Scan" Tag="&#xE721;" Style="{StaticResource Btn.Secondary}"
                        MinWidth="104" Click="ScanButton_Click" ToolTip="Scan as administrator to find system and app junk"/>
                <Button x:Name="CleanButton" Content="Clean selected" Tag="&#xE74D;" Style="{StaticResource Btn.Accent}"
                        MinWidth="150" Margin="10,0,0,0" Click="CleanButton_Click" IsEnabled="False"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
                <TextBlock x:Name="StatusText" Text="Scan to see what can be cleaned." Style="{StaticResource Text.Caption}"
                           TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="ProgressBar" Style="{StaticResource Progress}" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- Results: one surface, grouped by section -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0,6" Margin="0,18,0,0">
            <Grid>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center"
                               Foreground="{StaticResource FgSubtleBrush}"/>
                    <TextBlock x:Name="EmptyHint" Text="Nothing scanned yet" Style="{StaticResource Text.Heading}"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Scan checks temp files, caches, developer tools and Windows leftovers. Nothing is deleted until you choose."
                               Style="{StaticResource Text.Body}" TextAlignment="Center" MaxWidth="320"/>
                </StackPanel>

                <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource Row}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Section}" Margin="20,16,20,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Display}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                        <Grid Margin="0,5,0,0" Visibility="{Binding WarningVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12"
                                                       Foreground="{StaticResource WarningBrush}" Margin="0,1,6,0" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1" Text="{Binding WarningText}" Style="{StaticResource Text.Caption}"
                                                       Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Style="{StaticResource Text.Base}"
                                               FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="14"
                                               VerticalAlignment="Top" Margin="16,0,0,0"/>
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
