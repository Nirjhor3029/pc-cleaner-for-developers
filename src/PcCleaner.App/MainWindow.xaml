<Window x:Class="PcCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PcCleaner.App"
        mc:Ignorable="d"
        Title="PC Cleaner" Height="600" Width="400" MinWidth="380" MinHeight="550"
        WindowStartupLocation="CenterScreen" Background="#1a1a2e" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Foreground" Value="#22c55e"/>
            <Setter Property="Background" Value="#2a2a4a"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="Track" Background="#2a2a4a" CornerRadius="4">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        MinWidth="8" Background="#22c55e" CornerRadius="4"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="PC CLEANER"
                   Foreground="White" FontSize="26" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,20,0,5"/>

        <TextBlock Grid.Row="0" Text="Scan &amp; remove junk files safely"
                   Foreground="#8b93a7" FontSize="13"
                   HorizontalAlignment="Center" Margin="0,58,0,0"/>

        <!-- Total Junk -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,25">
            <TextBlock Text="READY TO CLEAN" Foreground="#8b93a7" FontSize="12"
                       HorizontalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock x:Name="TotalSizeText" Text="0 GB"
                       Foreground="White" FontSize="40" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Scan / Clean Buttons -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                    Margin="0,105,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="ScanButton" Content="SCAN"
                        Style="{StaticResource MainButtonStyle}"
                        Background="#e94560" Width="120"
                        Click="ScanButton_Click"/>
                <Button x:Name="CleanButton" Content="CLEAN"
                        Style="{StaticResource MainButtonStyle}"
                        Background="#0f3460" Width="120" Margin="15,0,0,0"
                        Click="CleanButton_Click" IsEnabled="False"/>
            </StackPanel>
            <Button x:Name="DiskButton" Content="DISK ANALYZER  ▸"
                    Style="{StaticResource MainButtonStyle}"
                    Background="#533483" Width="255" Margin="0,12,0,0"
                    Click="DiskButton_Click"/>
        </StackPanel>

        <!-- Status text -->
        <TextBlock x:Name="StatusText" Grid.Row="1" Text="Ready"
                   Foreground="#b8c0d0" FontSize="12"
                   HorizontalAlignment="Center" Margin="0,214,0,0"/>

        <!-- Progress -->
        <ProgressBar x:Name="ProgressBar" Grid.Row="1"
                     Style="{StaticResource ProgressBarStyle}"
                     HorizontalAlignment="Center" Margin="0,236,0,0"
                     Visibility="Collapsed"/>

        <!-- Results List -->
        <Border Grid.Row="2" Background="#16213e" CornerRadius="8"
                Margin="0,20,0,0" BorderBrush="#2a2a4a" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CATEGORY" Foreground="#94a3b8" FontSize="11"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="SIZE" Foreground="#94a3b8" FontSize="11"
                               FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="Click SCAN to find junk files"
                           Foreground="#7d8aa3" FontSize="13" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <ListBox x:Name="ResultsList" Grid.Row="1"
                         Background="Transparent" BorderThickness="0"
                         Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Padding="15,10,15,4" Background="#12172e">
                                        <TextBlock Text="{Binding Name}" Foreground="#7f5af0" FontSize="13"
                                                   FontWeight="Bold" FontFamily="Segoe UI"/>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="15,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <CheckBox x:Name="chk" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Display}" Foreground="#94a3b8" FontSize="11"/>
                                                        <TextBlock Text="{Binding WarningText}" Foreground="#ffb86c" FontSize="11"
                                                                   Visibility="{Binding WarningVisibility}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}"
                                                               Foreground="#ccc" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </Grid>
                                            </CheckBox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1f2b4a"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>