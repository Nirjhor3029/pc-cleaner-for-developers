<UserControl x:Class="PcCleaner.App.Views.ResourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20" Background="#0f0f1e">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="🧠 Resource Monitor" Foreground="White" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Graceful Close → Kill. Critical system processes are protected (End Task disabled)." Foreground="#94a3b8" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
            <Button Content="▶ Start" Width="80" Height="30" Style="{StaticResource MainButtonStyle}" Background="#22c55e" FontSize="12" Command="{Binding StartMonitoringCommand}"/>
            <Button Content="⏹ Stop" Width="80" Height="30" Style="{StaticResource MainButtonStyle}" Background="#533483" FontSize="12" Margin="8,0,0,0" Command="{Binding StopMonitoringCommand}"/>
            <TextBlock Text="{Binding StatusText}" Foreground="#b8c0d0" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="CPU" Foreground="#94a3b8" FontSize="11" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0}%}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="  RAM" Foreground="#94a3b8" FontSize="11" Margin="8,0,4,0"/>
                <TextBlock Text="{Binding RamPercent, StringFormat={}{0:0}%}" Foreground="White" FontWeight="Bold" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Top CPU / Memory (WorkingSet)" Foreground="#7f5af0" FontWeight="Bold" FontSize="12"/>
                    <DataGrid ItemsSource="{Binding TopCpu}" AutoGenerateColumns="False" Background="#16213e" Foreground="White" GridLinesVisibility="None" HeadersVisibility="Column" BorderThickness="0" Margin="0,8,0,0" MaxHeight="400">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Memory" Binding="{Binding MemoryDisplay}" Width="90"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="End Task" FontSize="10" Height="20" Padding="6,0" Background="#e94560" Foreground="White" BorderThickness="0"
                                                Command="{Binding DataContext.EndTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Top Memory" Foreground="#7f5af0" FontWeight="Bold" FontSize="12"/>
                    <DataGrid ItemsSource="{Binding TopMemory}" AutoGenerateColumns="False" Background="#16213e" Foreground="White" GridLinesVisibility="None" HeadersVisibility="Column" BorderThickness="0" Margin="0,8,0,0" MaxHeight="400">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Memory" Binding="{Binding MemoryDisplay}" Width="90"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
