<Window x:Class="PcCleaner.App.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Cleaner — Performance &amp; Health Manager" Height="700" Width="1050"
        MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="#0f0f1e" ResizeMode="CanResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1a1a2e" BorderBrush="#2a2a4a" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="16,18,16,12">
                    <TextBlock Text="PC CLEANER" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Performance &amp; Health" Foreground="#7f5af0" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    <TextBlock x:Name="HealthBadge" Text="Score —" Foreground="#94a3b8" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="8,8,8,0">
                    <Button x:Name="NavDashboard" Content="📊  Dashboard" Style="{StaticResource NavActiveButtonStyle}" Click="Nav_Click" Tag="Dashboard" Margin="0,2"/>
                    <Button x:Name="NavCleaner" Content="🧹  Cleaner" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Cleaner" Margin="0,2"/>
                    <Button x:Name="NavStartup" Content="🚀  Startup" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Startup" Margin="0,2"/>
                    <Button x:Name="NavResource" Content="🧠  Resource" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Resource" Margin="0,2"/>
                    <Button x:Name="NavAnalyzer" Content="🔍  Disk Analyzer" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Analyzer" Margin="0,2"/>
                    <Button x:Name="NavHistory" Content="📈  History" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="History" Margin="0,2"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="12,12">
                    <TextBlock Text="v1.0 — MVP" Foreground="#555" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock Text="github.com/Nirjhor3029" Foreground="#444" FontSize="9" HorizontalAlignment="Center" Margin="0,2"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Border Grid.Column="1" Background="#0f0f1e">
            <ContentControl x:Name="MainContent"/>
        </Border>
    </Grid>
</Window>
