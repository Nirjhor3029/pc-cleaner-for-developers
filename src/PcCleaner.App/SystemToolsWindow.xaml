<Window x:Class="PcCleaner.App.SystemToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System tools" Width="1000" Height="740" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">

    <Window.Resources>
        <!-- One option of a setting, e.g. Hibernation "Reduced" -->
        <DataTemplate x:Key="OptionTemplate">
            <RadioButton Style="{StaticResource OptionCard}" GroupName="{Binding GroupName}"
                         IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,10,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" FontSize="16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding CurrentVisibility}">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="Current" Style="{StaticResource Text.Caption}" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding BadgeVisibility}">
                        <TextBlock Text="{Binding Badge}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource FgBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" FontSize="12" LineHeight="17" Margin="0,10,0,0"/>
                </StackPanel>
            </RadioButton>
        </DataTemplate>

        <!-- One setting card -->
        <DataTemplate x:Key="TweakTemplate">
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}">
                            <TextBlock Text="{Binding IconGlyph}" Style="{StaticResource Icon}" FontSize="18"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Text.Title}" FontSize="19"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <Border Grid.Column="2" Style="{StaticResource Pill}">
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource FgBrush}"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" MaxWidth="660"
                               HorizontalAlignment="Left" Margin="0,16,0,0"/>
                    <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource FgSubtleBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <ItemsControl ItemsSource="{Binding Options}" ItemTemplate="{StaticResource OptionTemplate}" Margin="0,20,-10,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Grid Margin="0,20,0,0">
                        <TextBlock Text="{Binding Message}" Visibility="{Binding MessageVisibility}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,180,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="Apply" Tag="&#xE73E;" Style="{StaticResource Btn.SmallAccent}" HorizontalAlignment="Right"
                                IsEnabled="{Binding CanApply}" Click="ApplyButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,24,18,20">
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,0">
                    <TextBlock Text="System tools" Style="{StaticResource Text.Title}"/>
                    <TextBlock Text="Windows settings that are usually spread across Settings, Control Panel and the command line."
                               Style="{StaticResource Text.Body}" FontSize="12" LineHeight="17" Margin="0,6,0,22"/>
                </StackPanel>

                <!-- Safety net at the bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="4,0">
                    <TextBlock Text="Safety net" Style="{StaticResource Text.Heading}"/>
                    <TextBlock Text="Save a restore point first so any system change can be rolled back from Windows Recovery."
                               Style="{StaticResource Text.Body}" FontSize="12" LineHeight="17" Margin="0,4,0,10"/>
                    <Button x:Name="RestorePointButton" Content="Create restore point" Tag="&#xE777;" Style="{StaticResource Btn.Small}"
                            HorizontalAlignment="Stretch" Click="RestorePointButton_Click"/>
                    <TextBlock x:Name="RestorePointStatus" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavPower" Content="Power and storage" Tag="&#xE7E8;" Style="{StaticResource NavItem}"
                                 GroupName="nav" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavStartup" Content="Startup apps" Tag="&#xE945;" Style="{StaticResource NavItem}"
                                 GroupName="nav" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,28,36,32">

                <Border x:Name="AdminBanner" Background="{StaticResource WarningSoftBrush}" CornerRadius="10"
                        Padding="16,12" Margin="0,0,0,24" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" Foreground="{StaticResource WarningBrush}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Base}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="You can look around, but changing these settings needs administrator rights."/>
                        <Button Grid.Column="2" Content="Restart as admin" Style="{StaticResource Btn.SmallAccent}" Margin="12,0,0,0"
                                Click="RestartAsAdmin_Click"/>
                    </Grid>
                </Border>

                <!-- Power and storage -->
                <StackPanel x:Name="PowerPanel">
                    <TextBlock Text="Power and storage" Style="{StaticResource Text.Title}" FontSize="26"/>
                    <TextBlock Text="Settings that decide how much of your system drive Windows keeps for itself."
                               Style="{StaticResource Text.Body}" Margin="0,6,0,22"/>
                    <ItemsControl x:Name="TweaksList" ItemTemplate="{StaticResource TweakTemplate}"/>
                </StackPanel>

                <!-- Startup apps -->
                <StackPanel x:Name="StartupPanel" Visibility="Collapsed">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Startup apps" Style="{StaticResource Text.Title}" FontSize="26"/>
                            <TextBlock x:Name="StartupSummary" Text="Apps that open by themselves when you sign in."
                                       Style="{StaticResource Text.Body}" Margin="0,6,0,22"/>
                        </StackPanel>
                        <Button Content="Refresh" Tag="&#xE72C;" Style="{StaticResource Btn.Small}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,4,0,0" Click="RefreshStartup_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="Turning an app off only stops it starting automatically. Nothing is uninstalled, and Task Manager shows the same setting."/>
                    <Border Style="{StaticResource Card}" Padding="0,6">
                        <ItemsControl x:Name="StartupList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="20,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                                    <Border Style="{StaticResource Pill}" Background="{StaticResource WarningSoftBrush}" Padding="7,1"
                                                            Margin="8,0,0,0" ToolTip="Estimated from the app type. Apps like this usually slow down sign-in.">
                                                        <Border.Visibility>
                                                            <Binding Path="IsHighImpact">
                                                                <Binding.Converter>
                                                                    <BooleanToVisibilityConverter/>
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </Border.Visibility>
                                                        <TextBlock Text="{Binding ImpactText}" Style="{StaticResource Text.Caption}" FontSize="10.5"
                                                                   Foreground="{StaticResource WarningBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                                                    <Run Text="{Binding Publisher, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding LocationText, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Command}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource FgSubtleBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Command}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Center" Margin="20,0,0,0"
                                                      IsChecked="{Binding IsEnabled, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                                                      ToolTip="{Binding ToggleToolTip}" ToolTipService.ShowOnDisabled="True"
                                                      Click="StartupToggle_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock x:Name="StartupError" Style="{StaticResource Text.Caption}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
