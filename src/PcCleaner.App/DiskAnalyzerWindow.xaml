<Window x:Class="PcCleaner.App.DiskAnalyzerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disk analyzer" Width="820" Height="680" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Disk analyzer" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="Largest folders first. Open a folder to look inside; nothing here deletes anything."
                       Style="{StaticResource Text.Caption}" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="DriveCombo" Style="{StaticResource Combo}" Width="96" SelectionChanged="DriveCombo_SelectionChanged"/>
            <Button Grid.Column="1" x:Name="BackButton" Content="Up" Tag="&#xE72B;" Style="{StaticResource Btn.Small}"
                    Margin="8,0,0,0" Click="BackButton_Click" IsEnabled="False" ToolTip="Back to the previous folder"/>
            <TextBlock x:Name="PathText" Grid.Column="2" Text="" Style="{StaticResource Text.Base}" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="3" x:Name="RescanButton" Content="Rescan" Tag="&#xE72C;" Style="{StaticResource Btn.Small}"
                    Click="RescanButton_Click"/>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="Choose a drive." Style="{StaticResource Text.Caption}"
                   Margin="0,12,0,12" TextWrapping="Wrap" MinHeight="16"/>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0,6">
            <Grid>
            <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center"
                           Foreground="{StaticResource FgSubtleBrush}"/>
                <TextBlock x:Name="LoadingText" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="Every file is counted, so large folders take a moment." Style="{StaticResource Text.Caption}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
            <ListBox x:Name="EntryList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="EntryList_MouseDoubleClick" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Row}">
                        <Setter Property="Padding" Value="20,10"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TypeIcon}" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,14,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource WarningSoftBrush}" Padding="7,1"
                                            Margin="8,0,0,0" Visibility="{Binding TagVisibility}"
                                            ToolTip="Belongs to Windows. Not junk, and PC Cleaner never deletes it.">
                                        <TextBlock Text="Windows" Style="{StaticResource Text.Caption}" FontSize="10.5" Foreground="{StaticResource WarningBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding FileCountDisplay}" Style="{StaticResource Text.Caption}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <!-- Share of the largest item in this folder -->
                            <Border Grid.Column="2" Height="6" CornerRadius="3" Background="{StaticResource MutedBrush}"
                                    VerticalAlignment="Center" Margin="16,0">
                                <ProgressBar Value="{Binding BarPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource Progress}"/>
                            </Border>
                            <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" Style="{StaticResource Text.Base}"
                                       FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="Double-click a folder to open it." Style="{StaticResource Text.Caption}"
                   Foreground="{StaticResource FgSubtleBrush}" Margin="0,10,0,0"/>
    </Grid>
</Window>
